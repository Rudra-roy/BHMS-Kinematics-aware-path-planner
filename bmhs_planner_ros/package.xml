<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>bmhs_planner_ros</name>
  <version>1.0.0</version>
  <description>
    BMHS (Bidirectional Multi-Heuristic Search) Path Planner for ROS2.
    Kinematic-aware path planning for ground vehicles with C++ accelerated
    multi-heuristic Dijkstra, Bezier smoothing, and nav2-compatible action interfaces.
  </description>
  <maintainer email="rudra@todo.com">Hironmoy Roy Rudra</maintainer>
  <license>GPL-3.0-only</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>nav_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>

  <build_depend>OpenCV</build_depend>
  <exec_depend>rviz2</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
